BILIBILI_FILTER_HOST=127.0.0.1
BILIBILI_FILTER_PORT=8765
BILIBILI_FILTER_DATABASE=data/bilibili-filter.sqlite3
BILIBILI_FILTER_WEB_ROOT=web/dist
BILIBILI_FILTER_LOG_LEVEL=INFO
# Remote OpenAI-compatible model; BASE_URL and MODEL are required for analysis.
BILIBILI_FILTER_OPENAI_BASE_URL=
BILIBILI_FILTER_OPENAI_API_KEY=
BILIBILI_FILTER_OPENAI_MODEL=
# Native blacklist pacing: one action per interval plus a random jitter.
BILIBILI_FILTER_BLACKLIST_INTERVAL_SECONDS=60
BILIBILI_FILTER_BLACKLIST_JITTER_SECONDS=30
BILIBILI_FILTER_OPENAI_CONTEXT_TOKENS=100000
BILIBILI_FILTER_OPENAI_MAX_OUTPUT_TOKENS=4096
# Split model work before a large UID batch becomes slow or output-heavy.
BILIBILI_FILTER_OPENAI_MAX_BATCH_ACCOUNTS=32
# Read timeout per model request; increase for slower remote inference endpoints.
BILIBILI_FILTER_OPENAI_TIMEOUT_SECONDS=120
BILIBILI_FILTER_WORKER_ENABLED=true
BILIBILI_FILTER_BROWSER_HEADLESS=true
